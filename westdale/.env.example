# Copy to .env (never commit) or set in your host's environment settings.
NODE_ENV=production
PORT=3000
# Required in production: long random string (e.g. `openssl rand -hex 32`)
CSRF_SECRET=
# Where consultation requests are delivered
EMAIL_TO=steve@westdalefinancial.com
# Email delivery via Resend (https://resend.com). The FROM address must be on a domain verified with Resend.
RESEND_API_KEY=
EMAIL_FROM="Westdale Website <website@westdalefinancial.com>"
# Optional but recommended: Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Comma-separated origins allowed to POST the form
ALLOWED_ORIGINS=https://www.westdalefinancial.com,https://westdalefinancial.com
# Set to 1 only when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0
