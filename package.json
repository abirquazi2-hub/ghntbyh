{
  "name": "arts-autobody-site",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Art's Autobody & Collision Centre, Ottawa",
  "license": "UNLICENSED",
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o assets/css/site.css --minify",
    "watch:css": "tailwindcss -i src/input.css -o assets/css/site.css --watch",
    "csp": "node scripts/csp-hash.mjs",
    "build": "npm run build:css && npm run csp",
    "serve": "python3 -m http.server 8080"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abirquazi2-hub/ghntbyh.git"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "three": "0.160.0"
  }
}
