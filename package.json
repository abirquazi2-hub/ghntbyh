{
  "name": "arts-autobody-site",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Art's Autobody & Collision Centre, Ottawa",
  "license": "UNLICENSED",
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o assets/css/site.css --minify",
    "watch:css": "tailwindcss -i src/input.css -o assets/css/site.css --watch",
    "build:js": "esbuild src/app.js --bundle --format=iife --minify --legal-comments=eof --target=es2020 --outfile=assets/js/app.js",
    "build:model": "node scripts/embed-model.mjs",
    "build": "npm run build:css && npm run build:js && npm run build:model",
    "serve": "python3 -m http.server 8080"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abirquazi2-hub/ghntbyh.git"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.25.12",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "tailwindcss": "^4.3.3",
    "three": "0.160.0"
  }
}
